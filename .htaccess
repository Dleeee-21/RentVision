RewriteEngine On

# Redirect api endpoints without .php extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(auth/[a-zA-Z]+)$ api/$1.php [L,QSA]
RewriteRule ^api/([a-zA-Z-]+)$ api/$1.php [L,QSA]

# Redirect pages without .php extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^pages/([a-zA-Z]+)$ pages/$1.php [L,QSA]

# Admin panel
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/?$ admin/index.php [L,QSA]
